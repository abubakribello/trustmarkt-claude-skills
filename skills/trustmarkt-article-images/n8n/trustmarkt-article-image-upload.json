{
  "name": "Trustmarkt Article Image Upload",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "trustmarkt-article-image",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "is-create-folder",
      "name": "Is create_folder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "create_folder",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "create-folder",
      "name": "Create Article Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [460, 140],
      "parameters": {
        "resource": "folder",
        "operation": "create",
        "name": "={{ $json.body.article_slug }}",
        "folderId": { "mode": "id", "value": "={{ $json.body.folder_id }}" },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Drive account" }
      }
    },
    {
      "id": "is-image",
      "name": "Is image?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 340],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.body.type }}",
              "rightValue": "image",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "upload-image",
      "name": "Upload Image to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [700, 260],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "={{ $json.body.filename }}",
        "driveId": { "mode": "list", "value": "My Drive" },
        "folderId": { "mode": "id", "value": "={{ $json.body.folder_id }}" },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Drive account" }
      }
    },
    {
      "id": "markdown-to-file",
      "name": "Markdown to File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 440],
      "parameters": {
        "jsCode": "const text = $json.body.markdown || '';\nreturn [{\n  json: $json,\n  binary: {\n    manifest: {\n      data: Buffer.from(text, 'utf-8').toString('base64'),\n      mimeType: 'text/markdown',\n      fileName: 'manifest.md'\n    }\n  }\n}];"
      }
    },
    {
      "id": "upload-manifest",
      "name": "Upload Manifest to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [920, 440],
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "name": "manifest.md",
        "binaryPropertyName": "manifest",
        "driveId": { "mode": "list", "value": "My Drive" },
        "folderId": { "mode": "id", "value": "={{ $json.body.folder_id }}" },
        "options": {}
      },
      "credentials": {
        "googleDriveOAuth2Api": { "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID", "name": "Google Drive account" }
      }
    },
    {
      "id": "merge",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1140, 300],
      "parameters": { "mode": "combine", "numberInputs": 3 }
    },
    {
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1360, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, id: $json.id, name: $json.name } }}"
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Is create_folder?", "type": "main", "index": 0 }]] },
    "Is create_folder?": {
      "main": [
        [{ "node": "Create Article Folder", "type": "main", "index": 0 }],
        [{ "node": "Is image?", "type": "main", "index": 0 }]
      ]
    },
    "Create Article Folder": { "main": [[{ "node": "Merge", "type": "main", "index": 0 }]] },
    "Is image?": {
      "main": [
        [{ "node": "Upload Image to Drive", "type": "main", "index": 0 }],
        [{ "node": "Markdown to File", "type": "main", "index": 0 }]
      ]
    },
    "Upload Image to Drive": { "main": [[{ "node": "Merge", "type": "main", "index": 1 }]] },
    "Markdown to File": { "main": [[{ "node": "Upload Manifest to Drive", "type": "main", "index": 0 }]] },
    "Upload Manifest to Drive": { "main": [[{ "node": "Merge", "type": "main", "index": 2 }]] },
    "Merge": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
